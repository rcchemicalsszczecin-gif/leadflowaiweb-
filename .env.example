# LeadFlowAI environment template.
# Never commit real secrets.
NEXT_PUBLIC_SITE_URL=https://leadflowai.pl

# Server-only lead delivery configuration.
# Production webhook must use HTTPS. Token is optional and sent as Bearer auth when configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Optional server-only AI provider for the site assistant.
# Provider must be HTTPS in production and accept an OpenAI-compatible chat payload.
CHAT_PROVIDER_URL=
CHAT_PROVIDER_TOKEN=
CHAT_PROVIDER_MODEL=
