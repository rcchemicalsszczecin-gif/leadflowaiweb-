{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!app/premium-composition-v8.css",
      "!app/premium-composition-v8-themes.css",
      "!app/premium-art-direction-v9.css",
      "!app/premium-art-direction-v9-polish.css",
      "!app/premium-calibration-v9-2.css",
      "!app/responsive-performance-v10.css",
      "!app/runtime-performance-v10.css",
      "!app/v13-visual-authority.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
