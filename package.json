{
  "name": "leadflowai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --max-diagnostics=100 .",
    "format": "biome format --write .",
    "search:contract": "node scripts/search-contract.mjs",
    "lead:contract": "node scripts/lead-contract.mjs",
    "chat:contract": "node scripts/chat-contract.mjs",
    "content:contract": "node scripts/content-contract.mjs",
    "operations:contract": "node scripts/operations-contract.mjs",
    "static:contract": "node scripts/static-deploy-contract.mjs",
    "design:contract": "node scripts/design-v3-contract.mjs",
    "check": "npm run typecheck && npm run lint",
    "verify": "npm run search:contract && npm run lead:contract && npm run chat:contract && npm run content:contract && npm run operations:contract && npm run static:contract && npm run design:contract && npm run check && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
